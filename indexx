function cpKey(sap,name){
 const s=String(sap??'').trim().replace(/\.0+$/,'').toUpperCase();
 if(s&&s!=='0'&&s!=='-')return s;
 const k=String(name||'').trim().toLowerCase();
 return k?'N:'+k:'';
}
// Barcha kontragentlar indeksi (DT-KT varag'i + operatsiyalardan topilganlar)
function cpIndex(){
 if(window._cpIdx&&window._cpIdx.src===M.ops&&window._cpIdx.dk===M.dtkt)return window._cpIdx;
 const by={},order=[];
 const ensure=(key,name,sap,grp,idx)=>{
  if(!by[key]){by[key]={key,name,sap:sap||'',grp:grp||'',idx:idx==null?-1:idx,ops:[],names:{},du:0,ku:0,dd:0,kd:0};order.push(key)}
  return by[key];
 };
 let g='';
 (M.dtkt||[]).forEach((d,i)=>{
  if(d.tot)return;
  if(d.grp){g=d.name;return}
  const key=cpKey(d.sap,d.name);if(!key||by[key])return;
  ensure(key,d.name,(d.sap&&d.sap!=='-')?d.sap:'',g||'Boshqa',i);
 });
 (M.ops||[]).forEach(o=>{
  o.du=o.du||0;o.ku=o.ku||0;o.dd=o.dd||0;o.kd=o.kd||0;o.s=o.s||CP_SRC[o.t].l;
  const key=cpKey(o.sap,o.k);if(!key)return;
  const c=ensure(key,o.k||o.sap,o.sap,"DT-KT jadvalida yo'q",-1);
  c.ops.push(o);c.names[o.k]=(c.names[o.k]||0)+1;
  c.du+=o.du;c.ku+=o.ku;c.dd+=o.dd;c.kd+=o.kd;
 });
 order.forEach(k=>{const c=by[k];if(c.idx<0){const top=Object.entries(c.names).sort((a,b)=>b[1]-a[1])[0];if(top&&top[0])c.name=top[0]}c.ops.sort((a,b)=>a.ts-b.ts||(CP_SRC[a.t].o-CP_SRC[b.t].o))});
 const gOrder=[...DTKT_GROUPS,'Boshqa',"DT-KT jadvalida yo'q"];
 const list=order.map(k=>by[k]).sort((a,b)=>{const ga=gOrder.indexOf(a.grp),gb=gOrder.indexOf(b.grp);return (ga<0?99:ga)-(gb<0?99:gb)||(a.idx<0&&b.idx<0?String(a.name).localeCompare(String(b.name)):a.idx-b.idx)});
 return window._cpIdx={src:M.ops,dk:M.dtkt,by,list};
}
const cpUseU=()=>getCurr()==='UZS';
const cpFmt=v=>{
 if(!v||Math.abs(v)<0.005)return '—';
 return cpUseU()?Math.round(Math.abs(v)).toLocaleString('ru-RU'):Math.abs(v).toLocaleString('ru-RU',{minimumFractionDigits:2,maximumFractionDigits:2});
};
const cpDate=ts=>{const s=String(ts);return `${s.slice(6,8)}.${s.slice(4,6)}.${s.slice(0,4)}`};
const cpIso=ts=>{const s=String(ts);return `${s.slice(0,4)}-${s.slice(4,6)}-${s.slice(6,8)}`};
const cpTs=iso=>iso?+iso.replace(/-/g,''):0;
const cpBalTag=v=>{
 if(!v||Math.abs(v)<0.005)return '<span class="mu">0</span>';
 return v>0?`<span class="pos">${cpFmt(v)}</span> <span class="text-[10px] mu">Dt</span>`:`<span class="neg">${cpFmt(v)}</span> <span class="text-[10px] mu">Kt</span>`;
};

function dtktCardCompute(){
 const idx=cpIndex(),sel=window.dtktSel;
 const c=sel&&idx.by[sel];if(!c)return null;
 const U=cpUseU(),vd=o=>U?o.du:o.dd,vk=o=>U?o.ku:o.kd;
 const from=cpTs(window.dtktFrom),to=cpTs(window.dtktTo)||99999999;
 const run=[];let bal=0,opening=0;
 c.ops.forEach(o=>{
  if(o.ts<from)opening+=vd(o)-vk(o);
  bal+=vd(o)-vk(o);run.push(bal);
 });
 const rows=[];let tDt=0,tKt=0;const bySrc={},byMonth={};
 c.ops.forEach((o,i)=>{
  if(o.ts<from||o.ts>to)return;
  const d=vd(o),k=vk(o);tDt+=d;tKt+=k;
  const s=bySrc[o.t]||(bySrc[o.t]={n:0,dt:0,kt:0});s.n++;s.dt+=d;s.kt+=k;
  const ym=Math.floor(o.ts/100),m=byMonth[ym]||(byMonth[ym]={dt:0,kt:0,end:0,n:0});m.dt+=d;m.kt+=k;m.end=run[i];m.n++;
  rows.push({o,d,k,bal:run[i]});
 });
 return {c,rows,opening,closing:opening+tDt-tKt,tDt,tKt,bySrc,byMonth,all:c.ops,run};
}

