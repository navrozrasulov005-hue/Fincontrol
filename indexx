function cfDetail(idx){
 const p=M&&M.cf&&M.cf.rows&&M.cf.rows[idx];if(!p)return;
 window.cfOpsIdx=idx;
 window.cfOpsFrom=window.cfOpsTo=null;
 window.cfOpsAll=false;
 window.cfOpsSrc=p.isRed?'Kassa (Cash)':'all';
 window.cfOpsDir=p.sign==='+'?'in':p.sign==='-'?'out':'all';
 // Agar tanlangan filtrda qator chiqmasa, avtomatik 'all' ga tushiradi
 const test=cfOpsCompute();
 if(test&&!test.rows.length&&test.all.length){
  window.cfOpsSrc='all';
  if(!cfOpsCompute().rows.length)window.cfOpsDir='all';
 }
 window.cfView='ops';
 go('cf');
}

function cfOpsCompute(){
 const p=M&&M.cf&&M.cf.rows&&M.cf.rows[window.cfOpsIdx];if(!p)return null;
 const U=cpUseU();
 const cs=v=>{const s=String(v??'').trim().replace(/\.0+$/,'').toUpperCase();return /^(0|-|—)?$/.test(s)?'':s;};
 const rowSap=cs(p.sap),rowNm=String(p.name||'').trim().toLowerCase();
 const all=(M.ops||[]).filter(o=>{
  if(o.t!=='bank'&&o.t!=='cash')return false;
  const os=cs(o.sap),ok=String(o.k||'').trim().toLowerCase();
  if(rowSap)return os===rowSap;
  return Boolean(rowNm&&ok&&(ok.includes(rowNm)||rowNm.includes(ok)));
 }).map(o=>{
  const src=o.t==='cash'?'Kassa (Cash)':(o.s||'Bank');
  const inV=U?(o.ku||0):(o.kd||0),outV=U?(o.du||0):(o.dd||0);
  return {...o,src,inV,outV,netV:inV-outV};
 }).sort((a,b)=>a.ts-b.ts);

 const from=cpTs(window.cfOpsFrom),to=cpTs(window.cfOpsTo)||99999999;
 const dirF=window.cfOpsDir||'all',srcF=window.cfOpsSrc||'all';
 const periodAll=all.filter(o=>o.ts>=from&&o.ts<=to);
 const dirList=periodAll.filter(o=>dirF==='all'||(dirF==='in'?o.inV>0:o.outV>0));
 const bySrc={};
 dirList.forEach(o=>{
  const s=bySrc[o.src]||(bySrc[o.src]={t:o.t,n:0,inV:0,outV:0});
  s.n++;s.inV+=o.inV;s.outV+=o.outV;
 });
 const rows=dirList.filter(o=>srcF==='all'||o.src===srcF);
 const byMonth={};
 let tIn=0,tOut=0;
 rows.forEach(o=>{
  tIn+=o.inV;tOut+=o.outV;
  const ym=Math.floor(o.ts/100),m=byMonth[ym]||(byMonth[ym]={n:0,inV:0,outV:0});
  m.n++;m.inV+=o.inV;m.outV+=o.outV;
 });
 return {p,all,periodAll,dirList,rows,bySrc,byMonth,tIn,tOut,net:tIn-tOut};
}

