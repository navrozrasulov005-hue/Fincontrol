  const tsOf=p=>{const q=/^(\d{2})\.(\d{2})\.(\d{4})$/.exec((p&&p.str)||'');return q?(+q[3])*10000+(+q[2])*100+(+q[1]):0};
  const r2=v=>Math.round(n(v)*100)/100;
  const cut=(s,l)=>{s=String(s??'').replace(/\s+/g,' ').trim();return s.length>l?s.slice(0,l-1)+'…':s};
  // Ustunlar siljishi: SheetJS ba'zi varaqlarni B ustunidan boshlab o'qiydi — sarlavha ('Дата' / 'ФИО') bo'yicha moslashtiramiz
  const anch=(rows,re,exp)=>{for(let i=0;i<Math.min(rows.length,40);i++){const r=rows[i]||[];const j=r.findIndex(c=>re.test(String(c??'').trim()));if(j>=0)return{hi:i,sh:j-exp}}return null};
  // t: manba, sap, k: nomi, x: izoh, du/ku: Dt/Kt (UZS), dd/kd: Dt/Kt (USD)
  const push=(t,s,dateV,sap,k,x,du,ku,dd,kd)=>{
   const ts=tsOf(parseYM(dateV,2026));if(!ts)return;
   du=r2(du);ku=r2(ku);dd=r2(dd);kd=r2(kd);
   if(!du&&!ku&&!dd&&!kd)return;
   const sp=cs(sap),nm=cut(k,60);
   if(!sp&&!nm)return;
   const o={t,ts,sap:sp,k:nm,x:cut(x,100)};
   if(t==='bank')o.s=s;
   if(du)o.du=du;if(ku)o.ku=ku;if(dd)o.dd=dd;if(kd)o.kd=kd; // nol qiymatlar saqlanmaydi (hajmni kamaytirish uchun)
   ops.push(o);
  };
  // 1) Bank va Kassa varaqlari (Bank, Bank2..Bank8, Cash): RASXOD = Dt, PRIXOD = Kt
  wb.SheetNames.filter(sn=>/^(bank\d*|cash)$/i.test(String(sn||'').trim())).forEach(sn=>{
   const br=sheetRows(wb,sn);
   if(!br||br.length<5)return;
   const isCash=/^cash$/i.test(sn.trim());
   const A=anch(br,/^дата$/i,6)||{hi:isCash?14:2,sh:0},hi=A.hi,sh=A.sh;
   const eur=/€/.test(String((br[hi]||[])[16+sh]||''));
   const bName=isCash?'Kassa':cut((br[1]&&br[1][5+sh])||sn,30);
   const lbl=isCash?'Kassa (Cash)':`${bName} · ${sn}`;
   for(let i=hi+1;i<br.length;i++){
    const x=br[i]||[],g=k=>x[k+sh];
    const inUsd=n(g(22)),outUsd=n(g(23));
    let inUzs=n(g(24)),outUzs=n(g(25));
    if(eur){const rt=n(g(15));inUzs=inUsd*rt;outUzs=outUsd*rt}
    if(!inUsd&&!outUsd&&!inUzs&&!outUzs)continue;
    push(isCash?'cash':'bank',lbl,g(6),g(12),g(8),g(9),outUzs,inUzs,outUsd,inUsd);
   }
  });
  // 2) Sotuv (Sales): Dt
  ((out.sales&&out.sales.items)||[]).forEach(s=>{
   push('sales','Sotuv (Sales)',s.date,s.sap,s.kontr,[s.grp,s.srv,s.qty?('× '+fmt(s.qty)):''].filter(Boolean).join(' • '),s.tUzs,0,s.tUsd,0);
   if(s.nUzs||s.nUsd)push('vat','QQS (sotuv)',s.date,'V001','QQS 12%','Sotuv QQS: '+(s.kontr||''),0,s.nUzs,0,s.nUsd);
  });
  // 3) Услуги (bajarilgan ishlar akti): Kt
  const ur=sheetRows(wb,'Услуги');
  const uA=ur&&anch(ur,/^дата$/i,3);
  if(uA)for(let i=uA.hi+1;i<ur.length;i++){const x=ur[i]||[],g=k=>x[k+uA.sh];
   const tx=[g(10)?('SF №'+String(g(10)).trim()):'',g(11),g(13)].filter(Boolean).join(' • ');
   push('usl','Услуги',g(3),g(7),g(6),tx||'Xizmat',0,n(g(15)),0,n(g(18)));
   if(n(g(17))||n(g(20)))push('vat','QQS (xarid)',g(3),'V001','QQS 12%','Xarid QQS: '+(g(6)||''),n(g(17)),0,n(g(20)),0);
  }
  // 4) Местный (mahalliy TMZ kirimi): Kt
  const mr=sheetRows(wb,'Местный');
  const mA=mr&&anch(mr,/^дата$/i,3);
  if(mA)for(let i=mA.hi+1;i<mr.length;i++){const x=mr[i]||[],g=k=>x[k+mA.sh];
   const tx=[g(10)?('SF №'+String(g(10)).trim()):'',g(12),n(g(14))?(fmt(g(14))+' '+String(g(13)||'').trim()):''].filter(Boolean).join(' • ');
   push('loc','Местный (TMZ)',g(3),g(7),g(6),tx||'Tovar',0,n(g(18)),0,n(g(22)));
   if(n(g(17))||n(g(21)))push('vat','QQS (xarid)',g(3),'V001','QQS 12%','Xarid QQS: '+(g(6)||''),n(g(17)),0,n(g(21)),0);
  }
  // 5) Импорт (invoys): Kt (USD = Итого $, UZS = Итого Sum)
  const ir=sheetRows(wb,'Импорт');
  const iA=ir&&anch(ir,/^дата$/i,3);
  if(iA)for(let i=iA.hi+1;i<ir.length;i++){const x=ir[i]||[],g=k=>x[k+iA.sh];
   const tx=[g(14),n(g(16))?(fmt(g(16))+' '+String(g(15)||'').trim()):'',g(8)?('CMR '+String(g(8)).trim()):''].filter(Boolean).join(' • ');
   push('imp','Импорт (invoys)',g(3),g(5),g(6),tx||'Import',0,n(g(21)),0,n(g(20)));
  }
  // 6) Импорт доп (bojxona, logistika, deklaratsiya): Kt
  const xr=sheetRows(wb,'Импорт доп');
  const xA=xr&&anch(xr,/^дата$/i,3);
  if(xA)for(let i=xA.hi+1;i<xr.length;i++){const x=xr[i]||[],g=k=>x[k+xA.sh];
   const tx=[g(10),g(9)?('SF '+String(g(9)).trim()):'',g(15)].filter(Boolean).join(' • ');
   push('impx','Import xarajati (Импорт доп)',g(3),g(7),g(6),tx||'Import xarajati',0,n(g(17)),0,n(g(21)));
   if(n(g(20))||n(g(23)))push('vat','QQS (xarid)',g(3),'V001','QQS 12%','Xarid QQS: '+(g(6)||''),n(g(20)),0,n(g(23)),0);
  }
  // 7) Ish haqi va soliqlar (W&T): S001-S003 (Kt = qo'liga), P001 НДФЛ, P002 ЕСП, P003 ИНПС
  const wr=sheetRows(wb,'W&T');
  const wA=wr&&anch(wr,/^ФИО/i,3);
  if(wA)for(let i=wA.hi+1;i<wr.length;i++){const x=wr[i]||[],g=k=>x[k+wA.sh];
   const code=cs(g(6));
   const who=cut(g(3),40),tx=[who,g(4),g(7)].filter(Boolean).join(' • ');
   if(/^S00[1-3]$/.test(code))push('pay','Ish haqi (W&T)',g(1),code,'Ish haqi '+code,tx,0,n(g(23)),0,n(g(24)));
   if(String(g(7)||'').trim().toLowerCase()!=='rockgeo 2'&&who){
    push('pay','Soliq (W&T)',g(1),'P001','НДФЛ (soliq)',who,0,n(g(17)),0,n(g(20)));
    push('pay','Soliq (W&T)',g(1),'P002','ЕСП (soliq)',who,0,n(g(19)),0,n(g(22)));
    push('pay','Soliq (W&T)',g(1),'P003','ИНПС (soliq)',who,0,n(g(18)),0,n(g(21)));
   }
  }
  return ops;
 })();log('ops','Bank + Kassa + Sotuv + Услуги + Местный + Импорт + Импорт доп + W&T',out.ops);

