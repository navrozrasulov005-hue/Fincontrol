function tableToCleanSheet(tbl){
 const rows=[];
 const colWidths=[];
 tbl.querySelectorAll('tr').forEach(trEl=>{
  if(trEl.classList.contains('hid'))return;
  const row=[];
  let cIdx=0;
  trEl.querySelectorAll('th,td').forEach(cell=>{
   const cs=parseInt(cell.getAttribute('colspan')||'1',10)||1;
   const txt=String(cell.innerText||cell.textContent||'').replace(/\s+/g,' ').trim();
   colWidths[cIdx]=Math.max(colWidths[cIdx]||8,Math.min(txt.length+3,42));
   if(txt==='—'||txt==='–'||txt==='-'||txt===''){
    row.push('');
   }else if(cell.classList.contains('num')||/^[-+]?\$?\s?[\d\s\u00A0]+([,\.]\d+)?\s?(so'm|%)?$/.test(txt)){
    const isPct=txt.endsWith('%');
    const isUsd=txt.includes('$');
    const isUzs=txt.includes("so'm");
    const numVal=n(txt);
    if(isFinite(numVal)&&/\d/.test(txt)){
     row.push({v:isPct?numVal/100:numVal,t:'n',z:isPct?'0.0%':isUsd?'$#,##0.00':isUzs?'#,##0" so\'m"':'#,##0.##'});
    }else{
     row.push(txt);
    }
   }else{
    row.push(txt);
   }
   for(let k=1;k<cs;k++)row.push('');
   cIdx+=cs;
  });
  if(row.length)rows.push(row);
 });
 const ws=XLSX.utils.aoa_to_sheet(rows);
 ws['!cols']=colWidths.map(w=>({wch:Math.max(w||10,10)}));
 return ws;
}

function doExport(allTabs){
 const wb=XLSX.utils.book_new();
