.pnl-tbl tbody tr:hover td{background:rgba(255,255,255,.05)}
div:has(>.pnl-tbl){max-height:calc(100vh - 125px);overflow:auto}
.sub-bar+div:has(>.pnl-tbl){max-height:calc(100vh - 205px)}
.pnl-tbl thead th{position:sticky;top:0;background:var(--panel);z-index:5;box-shadow:inset 0 -1px 0 var(--line)}
.pnl-tbl thead th:first-child{z-index:6}
.pnl-tbl thead th:last-child{background:#1b2016}
.inv-tbl th,.inv-tbl td{padding:6px 8px!important;font-size:12px!important}
