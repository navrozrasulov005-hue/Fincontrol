<style>
:root{--bg:#0d1210;--panel:#141c18;--line:#24302a;--tx:#e7ece9;--mu:#8a9a92;--gold:#d4a63a;--pos:#4ade80;--neg:#fb7185}
body{font-family:'IBM Plex Sans',system-ui,sans-serif;background:var(--bg);color:var(--tx);font-size:14px}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:10px}
.num{font-variant-numeric:tabular-nums;text-align:right}
th{font-weight:500;color:var(--mu);text-align:left;padding:10px 14px;border-bottom:1px solid var(--line);white-space:nowrap}
td{padding:9px 14px;border-bottom:1px solid var(--line)}
tr:last-child td{border-bottom:0}
.nav{display:flex;align-items:center;gap:10px;width:100%;padding:9px 12px;border-radius:8px;color:var(--mu);border-left:2px solid transparent;cursor:pointer;text-align:left}
.nav:hover{color:var(--tx);background:#18221d}
.nav.on{color:var(--gold);background:#1b231c;border-left-color:var(--gold)}
.btn{background:var(--gold);color:#17130a;font-weight:600;padding:8px 14px;border-radius:8px;cursor:pointer;display:inline-flex;align-items:center;gap:8px}
.btn2{background:#1d2823;color:var(--tx);padding:8px 14px;border-radius:8px;cursor:pointer}
.inp{width:100%;background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:9px 12px;color:var(--tx)}
.inp:focus,.nav:focus-visible,.btn:focus-visible,.btn2:focus-visible{outline:2px solid var(--gold);outline-offset:1px}
.pos{color:var(--pos)}.neg{color:var(--neg)}.mu{color:var(--mu)}
.sub td{background:#101813;font-weight:600;color:var(--gold)}
.hid{display:none!important}
@media (min-width:768px){
  aside{position:sticky;top:0;height:100vh;align-self:flex-start;overflow-y:auto}
}
main>div:first-child{position:sticky;top:0;z-index:20;background:var(--bg);padding-top:12px;padding-bottom:12px;margin-top:-12px}
.sub-bar{position:sticky;top:56px;z-index:15;background:var(--bg);padding:6px 0 10px;margin-top:-6px}
.freeze th:nth-child(1),.freeze tr:not(.sub) td:nth-child(1){position:sticky;left:0;min-width:190px;width:190px;background:var(--panel);z-index:2}
.freeze th:nth-child(2),.freeze tr:not(.sub) td:nth-child(2){position:sticky;left:190px;min-width:190px;width:190px;background:var(--panel);z-index:2;border-right:1px solid var(--line)}
.freeze tr.sub td:first-child{position:sticky;left:0;background:#101813;z-index:2;border-right:1px solid var(--line)}
.pnl-tbl th,.pnl-tbl td{border-left:1px solid rgba(255,255,255,.06);font-variant-numeric:tabular-nums;white-space:nowrap}
