pnl(){
 if(!M||!M.pnl||!M.pnl.rows||!M.pnl.rows.length)return empty();
 const mode=window.pnlMode||'all',mi=window.pnlMonth!=null?window.pnlMonth:-1;
 const showPct=(window.pnlPct!==false);
 const pnlDir=window.pnlDir||'all';
 const heads=M.pnl.head||[], L=heads.length;
 const mHeads=heads.slice(0,-1),totLbl=heads[heads.length-1]||'Jami';

 const PNL_DIRS=[
  ['all',tr('Barchasi')],
  ['PREP-01','Дробление'],
  ['FA_AU_AAS','Пробирный анализ'],
  ['MULTI_ICP_OES','ICP-OES анализ']
 ];
 const mapDirName=nm=>{
  const s=String(nm||'').trim();
  if(/^prep-01$/i.test(s))return 'Дробление';
  if(/^fa_au_aas$/i.test(s))return 'Пробирный анализ';
  if(/^multi_icp_oes$/i.test(s))return 'ICP-OES анализ';
  return s;
 };
 const isDirCode=nm=>/^(prep-01|fa_au_aas|multi_icp_oes|дробление|пробирный анализ|icp-oes анализ)$/i.test(String(nm||'').trim());
 const fixTotal=(arr,isCum=false)=>{
  const out=Array.from({length:L},(_,i)=>n(arr&&arr[i]));
  if(L>1&&!out[L-1]){
   const mSum=out.slice(0,L-1).reduce((a,b)=>a+b,0);
   if(Math.abs(mSum)>0.0001)out[L-1]=isCum?(out.slice(0,L-1).reverse().find(Boolean)||0):mSum;
  }
  return out;
 };

 const cal=monthCal(2026,mi,[2026],"(y,m)=>{window.pnlMonth=m;if(m===-1)window.pnlMode='all';document.querySelector('.nav.on').click()}",[-1,'Barcha oylar']);
 const tabs=[['all','Oyma-oy jadval'],['one',"Tanlangan oy"]].map(([k,lbl])=>`<button type="button" class="${mode===k?'btn':'btn2'}" onclick="window.pnlMode='${k}';document.querySelector('.nav.on').click()">${esc(tr(lbl))}</button>`).join('');
 const pctBtn=`<button type="button" class="${showPct?'btn':'btn2'}" onclick="window.pnlPct=!window.pnlPct;document.querySelector('.nav.on').click()"><i class="fa-solid fa-percent"></i><span>% Ulushi</span></button>`;
 const dirBtns=PNL_DIRS.map(([k,lbl])=>`<button type="button" class="${pnlDir===k?'btn':'btn2'}" onclick="window.pnlDir='${k}';document.querySelector('.nav.on').click()">${esc(lbl)}</button>`).join('');

 const nav=`<div class="sub-bar space-y-2 mb-2">
  <div class="flex flex-wrap items-center justify-between gap-2">
