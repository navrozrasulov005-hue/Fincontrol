.inv-tbl th:nth-child(2),.inv-tbl tr:not(.sub) td:nth-child(2){position:sticky;left:75px!important;width:165px!important;min-width:165px!important;max-width:165px!important;white-space:normal!important;overflow-wrap:anywhere!important;line-height:1.25;background:var(--panel);border-right:1px solid var(--line);z-index:3}
.inv-tbl thead th:nth-child(1),.inv-tbl thead th:nth-child(2){z-index:7!important}
.inv-tbl tr.sub td{position:sticky;bottom:0;z-index:6;background:#101813!important;border-top:2px solid var(--gold)!important}
.inv-tbl tr.sub td:first-child{position:sticky;left:0!important;background:#101813!important;border-right:1px solid var(--line);z-index:8!important}
body.light{--bg:#f4f6f5;--panel:#ffffff;--line:#d5ddd9;--tx:#141c18;--mu:#5c6b64;--gold:#b8860b;--pos:#15803d;--neg:#dc2626}
