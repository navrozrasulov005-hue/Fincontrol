function getYears(extra){
 const ys=new Set([2026,2027,...(extra||[])]);
 if(M){
  if(M.costYear)ys.add(M.costYear);
  if(M.bsCols)M.bsCols.forEach(c=>c.y&&ys.add(c.y));
  if(M.dtktCols)M.dtktCols.forEach(c=>c.y&&ys.add(c.y));
  if(M.sales&&M.sales.years)M.sales.years.forEach(y=>y&&ys.add(y));
 }
 return [...ys].sort((a,b)=>a-b);
}
