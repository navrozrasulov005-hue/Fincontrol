   <div class="flex flex-wrap gap-1.5">${tabs}${pctBtn}</div>
  </div>
  <div class="flex flex-wrap items-center gap-1.5">${dirBtns}</div>
 </div>`;

 let dispRows=[];
 if(pnlDir==='all'){
  dispRows=M.pnl.rows.map(p=>{
   const raw=String(p.name||'').trim();
   const mapped=mapDirName(raw);
   const isCum=/долг\/предоплата/i.test(raw);
   return {name:mapped,rawName:raw,v:fixTotal(p.v,isCum),keepName:isDirCode(raw)};
  });
 }else{
  const dirRe=pnlDir==='PREP-01'?/^prep-01$|^дробление$/i:pnlDir==='FA_AU_AAS'?/^fa_au_aas$|^пробирный анализ$/i:/^multi_icp_oes$|^icp-oes/i;
  const costIdx=pnlDir==='PREP-01'?1:pnlDir==='FA_AU_AAS'?2:3;
  const dirLabel=pnlDir==='PREP-01'?'Дробление':pnlDir==='FA_AU_AAS'?'Пробирный анализ':'ICP-OES анализ';
  let curSec='';
  const secVals={};
  M.pnl.rows.forEach(p=>{
   const raw=String(p.name||'').trim();
   if(/чистая выручка|выручка от реализац/i.test(raw)){curSec='rev';return;}
   if(/себестоимость реализованной/i.test(raw)){curSec='cogs';return;}
   if(/расходы периода/i.test(raw)){curSec='opex';return;}
   if(/разница в обменном курсе наличных/i.test(raw)){curSec='fxCash';return;}
   if(/dt\/kt|дт\/кт/i.test(raw)){curSec='fxDtKt';return;}
   if(/налог на пр[иы]б/i.test(raw)){curSec='tax';return;}
   if(/^чистая прибыль/i.test(raw)){curSec='net';return;}
   if(curSec&&dirRe.test(raw)){secVals[curSec]=fixTotal(p.v);}
  });
  const mNumFromHead=h=>{
   const p=parseYM(h,2026);
   if(p.m>=1&&p.m<=12)return p.m;
   const idx=['yan','fev','mar','apr','may','iyun','iyul','avg','sen','okt','noy','dek'].findIndex(x=>String(h||'').toLowerCase().startsWith(x));
   return idx>=0?idx+1:0;
  };
  const costSecs=Array.isArray(M.cost)?M.cost.filter(s=>s&&!s.grandUnit&&Array.isArray(s.sum)):[];
  const fromCost=secIdx=>fixTotal(Array.from({length:L},(_,i)=>{
   if(i===L-1)return 0;
   const mn=mNumFromHead(heads[i]);
   return mn?n(costSecs[secIdx]?.sum?.[costIdx]?.ms?.[mn-1]):0;
  }));
  const fromSales=()=>{
   const items=Array.isArray(M?.sales?.items)?M.sales.items:[];
   return fixTotal(Array.from({length:L},(_,i)=>{
    if(i===L-1)return 0;
    const mn=mNumFromHead(heads[i]);
    return mn?items.filter(x=>x&&x.m===mn&&x.grp===dirLabel).reduce((s,x)=>s+n(x.sUsd),0):0;
   }));
  };
  const zeros=()=>Array(L).fill(0);
  const rev=secVals.rev||fromSales();
  const cogs=secVals.cogs||fromCost(0);
  const gp=rev.map((v,i)=>v-cogs[i]);
  const opex=secVals.opex||fromCost(1);
  const ebit=gp.map((v,i)=>v-opex[i]);
  const fxCash=secVals.fxCash||zeros();
  const fxDtKt=secVals.fxDtKt||zeros();
  const fin=fxCash.map((v,i)=>v+fxDtKt[i]);
  const ebt=ebit.map((v,i)=>v-fin[i]);
  const tax=secVals.tax||zeros();
  const netCalc=ebt.map((v,i)=>v-tax[i]);
  const netV=secVals.net||netCalc;
  let runCum=0;
  const cumV=Array.from({length:L},(_,i)=>{
   if(i===L-1)return runCum;
   runCum+=netV[i];
   return runCum;
  });
  dispRows=[
   {name:'Чистая выручка от реализации продукции',v:rev},
   {name:'Себестоимость реализованной продукции',v:cogs},
   {name:'Валовая прибыль (убыток)',v:gp},
   {name:'Расходы периода, всего',v:opex},
   {name:'Прибыль (убыток) от основной деятельности',v:ebit},
   {name:'Расходы по финансовой деятельности (Курсовая разница)',v:fin},
   {name:'Разница в обменном курсе наличных денег',v:fxCash},
   {name:'DT/KT-Курсовая разница',v:fxDtKt},
   {name:'Прибыль (убыток) до уплаты налога на прибыль',v:ebt},
   {name:'Налоги',v:tax},
   {name:'Чистая прибыль',v:netV},
   {name:'Долг/предоплата с прошлого месяца',v:cumV}
  ];
 }

