body.light .pnl-tbl thead th:last-child{background:#f3eedb}
body.light [style*="background:#101613"],body.light [style*="background:#101813"],body.light [style*="background:#141c18"]{background:#f1f5f3!important;color:var(--tx)!important}
body.light [style*="background:#162019"]{background:#e6ede9!important}
