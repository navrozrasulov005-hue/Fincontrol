/* === BI DASHBOARD DIZAYNI === */
.bi-hero{background:linear-gradient(135deg,#1e3a8a 0%,#2563eb 55%,#1d4ed8 100%);border-radius:12px;padding:14px 18px;color:#fff;box-shadow:0 8px 24px rgba(37,99,235,.22)}
